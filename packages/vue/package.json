{
  "name": "@cheese/vue",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/cheese-vue.js",
  "module": "./dist/cheese-vue.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/cheese-vue.js"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "vue": ">=3.4"
  },
  "dependencies": {
    "@cheese/css": "0.1.0",
    "@lucide/vue": "^1.47.0",
    "reka-ui": "^2.6.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "vue": "^3.5.21"
  },
  "scripts": {
    "build": "vite build && vue-tsc --emitDeclarationOnly",
    "typecheck": "vue-tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  }
}
