{
  "color": {
    "spaceBlack": "#111111",
    "lunarWhite": "#FFFFFF",
    "moonGray": "#F4F4F0",
    "cheeseGold": "#FFC928",
    "cheeseWeak": "#FFF3CC",
    "positive": "#21834F",
    "critical": "#D83B3B"
  },
  "semantic": {
    "bg": "{color.lunarWhite}",
    "surface": "#FAFAFA",
    "muted": "#F1F1F3",
    "text": "{color.spaceBlack}",
    "textSecondary": "#626269",
    "border": "#DEDEE3",
    "borderStrong": "#86868D",
    "brand": "{color.cheeseGold}",
    "brandSoft": "{color.cheeseWeak}",
    "danger": "#B4232F",
    "success": "#196C40",
    "shadow": "0 16px 56px rgb(0 0 0 / .12), 0 2px 8px rgb(0 0 0 / .04)",
    "overlay": "rgb(20 20 24 / .35)",
    "focus": "#785500",
    "duration": "150ms"
  },
  "font": {
    "family": "\"Pretendard Variable\", Pretendard, -apple-system, BlinkMacSystemFont, system-ui, sans-serif",
    "size": {
      "caption": 12,
      "label": 13,
      "body": 14,
      "heading": 20,
      "title": 32,
      "display": 48
    },
    "lineHeight": { "control": 1.2, "body": 1.5, "heading": 1.4 }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "6": 24, "8": 32 },
  "radius": { "control": 8, "card": 12, "overlay": 16, "pill": 999 }
}
