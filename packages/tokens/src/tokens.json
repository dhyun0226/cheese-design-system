{
  "color": {
    "spaceBlack": "#111111",
    "lunarWhite": "#FFFFFF",
    "moonGray": "#F4F4F0",
    "cheeseGold": "#FFC928",
    "cheeseWeak": "#FFF3CC",
    "positive": "#111111",
    "critical": "#111111"
  },
  "semantic": {
    "bg": "{color.lunarWhite}",
    "surface": "#FAFAFB",
    "muted": "#F5F5F7",
    "surfaceHover": "#EEEEF1",
    "text": "{color.spaceBlack}",
    "textSecondary": "#626269",
    "border": "#E5E5EA",
    "borderSubtle": "#EEEEF1",
    "borderStrong": "#8B8B90",
    "controlBg": "{color.lunarWhite}",
    "controlBorder": "#CECECE",
    "controlEdge": "#8B8B90",
    "controlHoverBorder": "#BBBBBB",
    "selectionIndicator": "#626269",
    "focusContrast": "#626269",
    "brand": "{color.cheeseGold}",
    "brandSoft": "{color.cheeseWeak}",
    "danger": "{color.spaceBlack}",
    "success": "{color.spaceBlack}",
    "shadow": "0 12px 36px rgb(17 17 17 / .10), 0 2px 8px rgb(17 17 17 / .04)",
    "shadowCard": "0 2px 8px rgb(17 17 17 / .025), 0 0 0 1px rgb(17 17 17 / .045)",
    "shadowDialog": "0 24px 80px rgb(17 17 17 / .16), 0 4px 16px rgb(17 17 17 / .06)",
    "shadowControl": "none",
    "shadowThumb": "0 1px 3px rgb(17 17 17 / .16), 0 0 0 1px var(--cheese-control-edge)",
    "overlay": "rgb(17 17 17 / .24)",
    "focus": "{color.cheeseGold}",
    "duration": "160ms"
  },
  "font": {
    "family": "\"Pretendard Variable\", Pretendard, -apple-system, BlinkMacSystemFont, system-ui, sans-serif",
    "size": {
      "caption": 12,
      "label": 13,
      "body": 14,
      "heading": 20,
      "title": 32,
      "display": 48
    },
    "lineHeight": { "control": 1.2, "body": 1.5, "heading": 1.4 }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "6": 24, "8": 32 },
  "radius": { "control": 10, "card": 16, "overlay": 20, "item": 8, "pill": 999 }
}
