{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "preserve",
    "types": ["vite/client", "vue"]
  },
  "include": [
    "site/**/*.vue",
    "site/vue-main.ts",
    "site/workflow-vue-main.ts",
    "site/env.d.ts"
  ]
}
